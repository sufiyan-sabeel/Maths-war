rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profile records: users/{userId}
    match /users/{userId} {
      // Anyone authenticated or reading leaderboards can read user profiles
      allow read: if true;
      
      // Only the authenticated user can create/update their own document
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.username is string
                    && request.resource.data.username.size() >= 3
                    && request.resource.data.username.size() <= 20;
                    
      allow update: if request.auth != null && request.auth.uid == userId
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'createdAt']));
                    
      allow delete: if false; // Profiles cannot be deleted client-side
    }

    // Usernames uniqueness registry: usernames/{username}
    match /usernames/{username} {
      allow read: if true;
      // Allow user to claim their unique lowercase username if not already taken
      allow create: if request.auth != null 
                    && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Leaderboards public collection
    match /leaderboard/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }
  }
}
